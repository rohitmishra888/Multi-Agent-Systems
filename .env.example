# ─────────────────────────────────────────────────────────────────────────────
# .env.example
# API Discovery Platform — Phase 1
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Target Application ────────────────────────────────────────────────────────
# Base URL of the VAmPI (Vulnerable API) application to scan.
# When running VAmPI locally via Docker:
#   docker run -p 5000:5000 erev0s/vampi
BASE_URL=http://localhost:5000

# ── HTTP Client Tuning ────────────────────────────────────────────────────────
# Per-request timeout in seconds (1–120)
REQUEST_TIMEOUT=10

# Maximum number of retry attempts for transient failures (0–10)
MAX_RETRIES=3

# Exponential back-off factor between retries (seconds)
# Wait = RETRY_BACKOFF_FACTOR * (2 ** attempt)
RETRY_BACKOFF_FACTOR=0.5

# ── Logging ───────────────────────────────────────────────────────────────────
# Valid values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Output ────────────────────────────────────────────────────────────────────
# Directory where catalog.json and catalog.yaml will be written.
# Created automatically if it doesn't exist.
OUTPUT_DIRECTORY=reports

# ── LLM / CrewAI ─────────────────────────────────────────────────────────────
# OpenAI API key for CrewAI LLM-orchestrated mode.
# Leave empty or omit to run in direct pipeline mode (no LLM).
OPENAI_API_KEY=

# OpenAI model to use for the CrewAI agent.
# Recommended: gpt-4o-mini (cost-effective) or gpt-4o (most capable)
OPENAI_MODEL_NAME=gpt-4o-mini

# ─────────────────────────────────────────────────────────────────────────────
# Advanced configuration (optional — defaults are production-ready)
# ─────────────────────────────────────────────────────────────────────────────

# Uncomment to customise the Swagger probe paths (comma-separated or JSON list)
# SWAGGER_PROBE_PATHS=["/swagger.json","/openapi.json","/docs","/api/docs"]

# Uncomment to use a custom word list for endpoint guessing
# COMMON_WORDLIST=["users","books","admin","auth","login","register"]

# Uncomment to customise version prefixes used during endpoint guessing
# VERSION_PREFIXES=["","/v1","/v2","/api/v1"]
